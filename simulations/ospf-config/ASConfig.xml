<?xml version="1.0" ?>
<OSPFASConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
        SINGLE shared OSPF AS config file — all routers defined here.
        INET 4.5 schema: root=OSPFASConfig, then Area + Router elements.
        Router name must match the OMNeT++ module name exactly.
        Interface ifName must match the actual Ethernet interface name
        as assigned by INET based on connection order in the .ned file.

        Interface mapping (from CampusNetwork.ned connection order):
        coreRouter:  eth0=seRouter, eth1=eeRouter, eth2=bbaRouter,
                     eth3=adminRouter, eth4=dnsServer, eth5=appServer
        seRouter:    eth0=coreRouter, eth1=seHost1, eth2=seHost2, eth3=seHost3
        eeRouter:    eth0=coreRouter, eth1=eeHost1, eth2=eeHost2, eth3=eeHost3
        bbaRouter:   eth0=coreRouter, eth1=bbaHost1, eth2=bbaHost2, eth3=bbaHost3
        adminRouter: eth0=coreRouter, eth1=adminHost1, eth2=adminHost2, eth3=adminHost3

        Link costs (reference bandwidth = 100Mbps):
          100Mbps backbone/server links => cost 1
          10Mbps  access links          => cost 10
    -->

    <!-- Area 0: backbone area — all routers in a single area -->
    <Area id="0.0.0.0">
        <!-- Advertise all campus subnets -->
        <AddressRange address="10.0.0.0" mask="255.255.255.0" status="Advertise"/>
        <AddressRange address="10.0.1.0" mask="255.255.255.0" status="Advertise"/>
        <AddressRange address="10.0.2.0" mask="255.255.255.0" status="Advertise"/>
        <AddressRange address="10.0.3.0" mask="255.255.255.0" status="Advertise"/>
        <AddressRange address="10.0.4.0" mask="255.255.255.0" status="Advertise"/>
        <AddressRange address="10.0.5.0" mask="255.255.255.0" status="Advertise"/>
        <AddressRange address="10.0.6.0" mask="255.255.255.0" status="Advertise"/>
    </Area>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- CORE ROUTER                                                 -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Router name="coreRouter" RFC1583Compatible="true">
        <!-- eth0: backbone to seRouter, 100Mbps, cost 1 -->
        <BroadcastInterface ifName="eth0" areaID="0.0.0.0"
                            interfaceOutputCost="1"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth1: backbone to eeRouter, 100Mbps, cost 1 -->
        <BroadcastInterface ifName="eth1" areaID="0.0.0.0"
                            interfaceOutputCost="1"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth2: backbone to bbaRouter, 100Mbps, cost 1 -->
        <BroadcastInterface ifName="eth2" areaID="0.0.0.0"
                            interfaceOutputCost="1"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth3: backbone to adminRouter, 100Mbps, cost 1 -->
        <BroadcastInterface ifName="eth3" areaID="0.0.0.0"
                            interfaceOutputCost="1"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth4: server link to dnsServer, 100Mbps, cost 1 -->
        <BroadcastInterface ifName="eth4" areaID="0.0.0.0"
                            interfaceOutputCost="1"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth5: server link to appServer, 100Mbps, cost 1 -->
        <BroadcastInterface ifName="eth5" areaID="0.0.0.0"
                            interfaceOutputCost="1"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>
    </Router>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SE ROUTER                                                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Router name="seRouter" RFC1583Compatible="true">
        <!-- eth0: backbone to coreRouter, 100Mbps, cost 1 -->
        <BroadcastInterface ifName="eth0" areaID="0.0.0.0"
                            interfaceOutputCost="1"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth1: access to seHost1, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth1" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth2: access to seHost2, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth2" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth3: access to seHost3, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth3" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>
    </Router>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- EE ROUTER                                                   -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Router name="eeRouter" RFC1583Compatible="true">
        <!-- eth0: backbone to coreRouter, 100Mbps, cost 1 -->
        <BroadcastInterface ifName="eth0" areaID="0.0.0.0"
                            interfaceOutputCost="1"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth1: access to eeHost1, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth1" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth2: access to eeHost2, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth2" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth3: access to eeHost3, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth3" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>
    </Router>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- BBA ROUTER                                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Router name="bbaRouter" RFC1583Compatible="true">
        <!-- eth0: backbone to coreRouter, 100Mbps, cost 1 -->
        <BroadcastInterface ifName="eth0" areaID="0.0.0.0"
                            interfaceOutputCost="1"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth1: access to bbaHost1, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth1" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth2: access to bbaHost2, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth2" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth3: access to bbaHost3, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth3" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>
    </Router>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ADMIN ROUTER                                                -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Router name="adminRouter" RFC1583Compatible="true">
        <!-- eth0: backbone to coreRouter, 100Mbps, cost 1 -->
        <BroadcastInterface ifName="eth0" areaID="0.0.0.0"
                            interfaceOutputCost="1"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth1: access to adminHost1, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth1" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth2: access to adminHost2, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth2" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>

        <!-- eth3: access to adminHost3, 10Mbps, cost 10 -->
        <BroadcastInterface ifName="eth3" areaID="0.0.0.0"
                            interfaceOutputCost="10"
                            routerPriority="1"
                            helloInterval="10"
                            routerDeadInterval="40"
                            retransmissionInterval="5"
                            interfaceTransmissionDelay="1"/>
    </Router>

</OSPFASConfig>