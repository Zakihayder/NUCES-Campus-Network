version 3
run RIP_CBR-0-20260509-22:27:31-18208
attr configname RIP_CBR
attr datetime 20260509-22:27:31
attr datetimef 20260509-222731
attr experiment RIP_CBR
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network simulations.CampusNetwork
attr processid 18208
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config image-path ../../inet4.5/images
config description "RIP Routing with CBR Traffic"
config *.coreRouter.hasRip true
config *.seRouter.hasRip true
config *.eeRouter.hasRip true
config *.bbaRouter.hasRip true
config *.adminRouter.hasRip true
config **.rip.updateInterval 30s
config **.rip.routeExpiryTime 180s
config **.rip.routePurgeTime 120s
config **.rip.splitHorizonMode "\"SplitHorizon\""
config *.tgSE1.trafficProfile "\"CBR\""
config *.tgSE2.trafficProfile "\"CBR\""
config *.tgSE3.trafficProfile "\"CBR\""
config *.tgSE1.packetSize 512B
config *.tgSE2.packetSize 512B
config *.tgSE3.packetSize 512B
config *.tgSE1.sendInterval 0.01s
config *.tgSE2.sendInterval 0.01s
config *.tgSE3.sendInterval 0.01s
config network simulations.CampusNetwork
config sim-time-limit 180s
config record-eventlog true
config **.scalar-recording true
config **.vector-recording true
config *.scenarioManager.script "xmldoc(\"failure_scenario.xml\")"
config *.configurator.assignAddresses true
config *.configurator.addStaticRoutes true
config *.configurator.addDefaultRoutes true
config *.configurator.addSubnetRoutes true
config *.configurator.dumpAddresses true
config *.configurator.dumpRoutes true
config *.tgSE1.destAddr "\"10.0.6.1\""
config *.tgSE2.destAddr "\"10.0.6.1\""
config *.tgSE3.destAddr "\"10.0.6.1\""
config *.tgSE1.startTime 20s
config *.tgSE2.startTime 20s
config *.tgSE3.startTime 20s
config *.tgSE1.stopTime 155s
config *.tgSE2.stopTime 155s
config *.tgSE3.stopTime 155s

