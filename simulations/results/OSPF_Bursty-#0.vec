attr network simulations.CampusNetwork
attr processid 10164
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config image-path ../../inet4.5/images
config description "OSPF Routing with Bursty Traffic"
config *.coreRouter.hasOspf true
config *.seRouter.hasOspf true
config *.eeRouter.hasOspf true
config *.bbaRouter.hasOspf true
config *.adminRouter.hasOspf true
config *.coreRouter.ospf.ospfConfig "xmldoc(\"ospf-config/ASConfig.xml\")"
config *.seRouter.ospf.ospfConfig "xmldoc(\"ospf-config/ASConfig.xml\")"
config *.eeRouter.ospf.ospfConfig "xmldoc(\"ospf-config/ASConfig.xml\")"
config *.bbaRouter.ospf.ospfConfig "xmldoc(\"ospf-config/ASConfig.xml\")"
config *.adminRouter.ospf.ospfConfig "xmldoc(\"ospf-config/ASConfig.xml\")"
config **.ospf.helloInterval 10s
config **.ospf.deadInterval 40s
config *.tgSE1.stopTime 0s
config *.tgSE2.stopTime 0s
config *.tgSE3.stopTime 0s
config *.seHost1.numApps 1
config *.seHost1.app[0].typename UdpBasicApp
config *.seHost1.app[0].destAddresses "\"appServer\""
config *.seHost1.app[0].destPort 5000
config *.seHost1.app[0].messageLength 512B
config *.seHost1.app[0].sendInterval 500ms
config *.seHost1.app[0].startTime 20s
config *.seHost1.app[0].stopTime 155s
config *.seHost2.numApps 1
config *.seHost2.app[0].typename UdpBasicApp
config *.seHost2.app[0].destAddresses "\"appServer\""
