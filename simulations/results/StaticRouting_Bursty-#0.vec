config image-path ../../inet4.5/images
config description "Custom Static Routing with Bursty Traffic"
config *.coreRouter.typename src.StaticRouter
config *.seRouter.typename src.StaticRouter
config *.eeRouter.typename src.StaticRouter
config *.bbaRouter.typename src.StaticRouter
config *.adminRouter.typename src.StaticRouter
config *.coreRouter.routeTable "\"10.0.1.0/24:0;10.0.2.0/24:1;10.0.3.0/24:2;10.0.4.0/24:3;10.0.5.0/24:4;10.0.6.0/24:5\""
