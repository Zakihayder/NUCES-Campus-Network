version 3
run OSPF-0-20260508-01:33:15-16012
attr configname OSPF
attr datetime 20260508-01:33:15
attr datetimef 20260508-013315
attr experiment OSPF
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network simulations.CampusNetwork
attr processid 16012
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config image-path ../../inet4.5/images
config description "Campus network with OSPF (Link-State routing)"
config *.coreRouter.hasOspf true
config *.seRouter.hasOspf true
config *.eeRouter.hasOspf true
config *.bbaRouter.hasOspf true
config *.adminRouter.hasOspf true
config *.coreRouter.hasRip false
config *.seRouter.hasRip false
config *.eeRouter.hasRip false
config *.bbaRouter.hasRip false
config *.adminRouter.hasRip false
config *.coreRouter.ospf.ospfConfig "xmldoc(\"ospf-config/ASConfig.xml\")"
config *.seRouter.ospf.ospfConfig "xmldoc(\"ospf-config/ASConfig.xml\")"
config *.eeRouter.ospf.ospfConfig "xmldoc(\"ospf-config/ASConfig.xml\")"
config *.bbaRouter.ospf.ospfConfig "xmldoc(\"ospf-config/ASConfig.xml\")"
config *.adminRouter.ospf.ospfConfig "xmldoc(\"ospf-config/ASConfig.xml\")"
config *.seHost*.numApps 1
config *.seHost*.app[0].typename UdpBasicApp
config *.seHost*.app[0].destAddresses "\"10.0.6.1\""
config *.seHost*.app[0].destPort 5000
config *.seHost*.app[0].messageLength 512B
config *.seHost*.app[0].sendInterval 10ms
config *.seHost*.app[0].startTime 20s
config *.seHost*.app[0].stopTime 155s
config *.appServer.numApps 1
config *.appServer.app[0].typename UdpSink
config *.appServer.app[0].localPort 5000
config *.scenarioManager.script "xmldoc(\"failure_scenario.xml\")"
config *.coreRouter.ospf.**.scalar-recording true
config *.coreRouter.ospf.**.vector-recording true
config *.seRouter.ospf.**.scalar-recording true
config *.seRouter.ospf.**.vector-recording true
config *.eeRouter.ospf.**.scalar-recording true
config *.eeRouter.ospf.**.vector-recording true
config *.bbaRouter.ospf.**.scalar-recording true
config *.bbaRouter.ospf.**.vector-recording true
config *.adminRouter.ospf.**.scalar-recording true
config *.adminRouter.ospf.**.vector-recording true
config network simulations.CampusNetwork
config sim-time-limit 180s
config record-eventlog false
config **.cmdenv-log-level info
config **.scalar-recording true
config **.vector-recording true
config *.configurator.addStaticRoutes true
config *.configurator.addDefaultRoutes true
config *.configurator.addSubnetRoutes true

