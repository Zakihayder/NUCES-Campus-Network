par CampusNetwork.configurator typename "\"inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator\""
par CampusNetwork.configurator minLinkWeight 0.001
par CampusNetwork.configurator configureIsolatedNetworksSeparatly false
par CampusNetwork.configurator config "<config>...</config> at content:1"
par CampusNetwork.configurator assignAddresses true
par CampusNetwork.configurator assignUniqueAddresses true
par CampusNetwork.configurator assignDisjunctSubnetAddresses true
par CampusNetwork.configurator addStaticRoutes true
par CampusNetwork.configurator addDefaultRoutes true
par CampusNetwork.configurator addSubnetRoutes true
par CampusNetwork.configurator addDirectRoutes true
par CampusNetwork.configurator optimizeRoutes true
par CampusNetwork.configurator dumpTopology false
par CampusNetwork.configurator dumpLinks false
par CampusNetwork.configurator dumpAddresses false
par CampusNetwork.configurator dumpRoutes false
par CampusNetwork.configurator dumpConfig "\"\""
par CampusNetwork.srMonitor typename "\"src.StaticRouter\""
par CampusNetwork.srMonitor numPorts 4
par CampusNetwork.srMonitor routeTable "\"10.0.2.0/255.255.255.0:1;10.0.3.0/255.255.255.0:2;10.0.4.0/255.255.255.0:3;10.0.5.0/255.255.255.0:0;10.0.6.0/255.255.255.0:0\""
par CampusNetwork.srMonitor ipAddress "\"0.0.0.0\""
scalar CampusNetwork.srMonitor totalForwarded 0
scalar CampusNetwork.srMonitor totalDropped 0
scalar CampusNetwork.srMonitor routingOverhead 0
scalar CampusNetwork.srMonitor linkUtilization:mean 0
attr interpolationmode linear
attr recordingmode mean
attr source linkUtilization
attr title "Link Utilization %, mean"
scalar CampusNetwork.srMonitor pktsDropped:count 0
attr interpolationmode none
attr recordingmode count
attr source pktsDropped
attr title "Packets Dropped, count"
scalar CampusNetwork.srMonitor pktsDropped:sum 0
attr interpolationmode none
attr recordingmode sum
attr source pktsDropped
attr title "Packets Dropped, sum"
scalar CampusNetwork.srMonitor pktsForwarded:count 0
attr interpolationmode none
attr recordingmode count
attr source pktsForwarded
attr title "Packets Forwarded, count"
scalar CampusNetwork.srMonitor pktsForwarded:sum 0
attr interpolationmode none
attr recordingmode sum
attr source pktsForwarded
attr title "Packets Forwarded, sum"
par CampusNetwork.scenarioManager typename "\"inet.common.scenario.ScenarioManager\""
par CampusNetwork.scenarioManager script "<scenario>...</scenario> at E:/cnet_lab/omnetpp-6.3.0/samples/i233009_Cnet_Project/simulations/\\failure_scenario.xml:2"
