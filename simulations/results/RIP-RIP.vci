config image-path ../../inet4.5/images
config network simulations.CampusNetwork
config description "Campus network with RIP routing"
config *.seHost1.numApps 1
config *.seHost1.app[0].typename UdpBasicApp
config *.seHost1.app[0].destAddresses "\"appServer\""
config *.seHost1.app[0].destPort 5000
config *.seHost1.app[0].messageLength 512B
config *.seHost1.app[0].sendInterval 10ms
config *.seHost1.app[0].startTime 20s
config *.seHost1.app[0].stopTime 155s
config *.seHost2.numApps 1
config *.seHost2.app[0].typename UdpBasicApp
config *.seHost2.app[0].destAddresses "\"appServer\""
config *.seHost2.app[0].destPort 5000
config *.seHost2.app[0].messageLength 512B
config *.seHost2.app[0].sendInterval 10ms
config *.seHost2.app[0].startTime 20s
config *.seHost2.app[0].stopTime 155s
config *.seHost3.numApps 1
config *.seHost3.app[0].typename UdpBasicApp
config *.seHost3.app[0].destAddresses "\"appServer\""
config *.seHost3.app[0].destPort 5000
config *.seHost3.app[0].messageLength 512B
config *.seHost3.app[0].sendInterval 10ms
config *.seHost3.app[0].startTime 20s
config *.seHost3.app[0].stopTime 155s
config *.appServer.numApps 1
config *.appServer.app[0].typename UdpSink
config *.appServer.app[0].localPort 5000
config *.coreRouter.hasRip true
config *.seRouter.hasRip true
config *.eeRouter.hasRip true
config *.bbaRouter.hasRip true
config *.adminRouter.hasRip true
config **.rip.updateInterval 30s
config **.rip.routeExpiryTime 180s
config **.rip.routePurgeTime 120s
config **.rip.splitHorizonMode "\"splitHorizon\""
config *.scenarioManager.script "xmldoc(\"failure_scenario.xml\")"
config output-scalar-file results/RIP-RIP.sca
config output-vector-file results/RIP-RIP.vec
config sim-time-limit 180s
config record-eventlog false
config **.cmdenv-log-level info
config **.scalar-recording true
config **.vector-recording true
config *.configurator.addStaticRoutes true
config *.configurator.addDefaultRoutes true
config *.configurator.addSubnetRoutes true

